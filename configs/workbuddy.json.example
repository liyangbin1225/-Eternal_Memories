{
  "_说明": "WorkBuddy 全局接入示例。把 <PROJECT> 替换为项目实际绝对路径，正斜杠或双反斜杠均可。修改前请备份 ~/.workbuddy/settings.json 与 ~/.workbuddy/mcp.json。",
  "mcpServers": {
    "eternal-memories": {
      "command": "python",
      "args": ["<PROJECT>/mcp_server.py"],
      "env": {
        "EM_DATA_DIR": "<PROJECT>/data",
        "PYTHONIOENCODING": "utf-8"
      },
      "disabled": false
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<PROJECT>/hooks/recall_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<PROJECT>/hooks/capture_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
